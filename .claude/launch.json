{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "vectasec-console",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@vectasec/web", "dev", "--port", "3100"],
      "port": 3100
    },
    {
      "name": "vectasec-engine",
      "runtimeExecutable": "services/engine/.venv/bin/python",
      "runtimeArgs": ["-m", "vectasec.api.main"],
      "port": 8000
    }
  ]
}
