  "policies_list": {"keys": ["default", "admin-sudo", "write-all", "app-scoped", "json-ro", "root"]},
  "policies": {
    "admin-sudo": "path \"sys/*\" {\n  capabilities = [\"read\", \"list\", \"sudo\"]\n}\n\npath \"auth/token/create\" {\n  capabilities = [\"create\", \"update\"]\n}\n",
    "narrow-sudo": "path \"pki/root/generate/internal\" {\n  capabilities = [\"update\", \"sudo\"]\n}\n",
    "write-all": "path \"*\" {\n  capabilities = [\"create\", \"read\", \"update\", \"delete\", \"list\"]\n}\n",
    "app-scoped": "path \"secret/data/app/*\" {\n  capabilities = [\"read\", \"list\"]\n}\n",
    "read-all": "path \"*\" {\n  capabilities = [\"read\", \"list\"]\n}\n",
    "default": "path \"auth/token/lookup-self\" {\n  capabilities = [\"read\"]\n}\n",
    "json-ro": {"path": {"secret/data/team/*": {"capabilities": ["read", "list"]}}}
  },
