{
  "openapi": "3.0.3",
  "info": {"title": "Orders API", "version": "1.4.0"},
  "servers": [
    {"url": "https://api.example.com/v1"},
    {"url": "http://legacy.example.com/v1"}
  ],
  "security": [{"bearerAuth": []}],
  "components": {
    "securitySchemes": {
      "bearerAuth": {"type": "http", "scheme": "bearer"},
      "legacyKey": {"type": "apiKey", "in": "query", "name": "api_key"}
    }
  },
  "paths": {
    "/orders": {
      "get": {
        "operationId": "listOrders",
        "responses": {"200": {"description": "ok"}}
      },
      "post": {
        "operationId": "createOrder",
        "security": [{"bearerAuth": []}],
        "responses": {"201": {"description": "created"}}
      }
    },
    "/health": {
      "get": {
        "operationId": "health",
        "security": [],
        "responses": {"200": {"description": "ok"}}
      }
    },
    "/legacy/export": {
      "get": {
        "operationId": "legacyExport",
        "deprecated": true,
        "security": [{"legacyKey": []}],
        "responses": {"200": {"description": "ok"}}
      }
    }
  }
}
