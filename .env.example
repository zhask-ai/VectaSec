# ─────────────────────────────────────────────────────────────
# VectaSec — environment. Copy to `.env` and fill in.
# `.env` is gitignored. NEVER commit real values.
# ─────────────────────────────────────────────────────────────

# ── Supabase: NON-SECRET (safe in the browser / fine to share) ──
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_PUBLISHABLE_KEY
# same two, exposed to the Next.js console:
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_PUBLISHABLE_KEY

# ── Supabase: SECRET (server-side only — do NOT paste in chat) ──
# From Settings → API (service_role / secret key):
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
# From Settings → Database (connection string; includes your DB password):
DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# ── Engine ──
ENGINE_PORT=8000
# Air-gapped estates: set to 1 to skip the live OSV vulnerability-feed enrichment after each
# scan (a recorded operator choice — no "feed unreachable" gap findings will accumulate).
VECTASEC_OSV_DISABLED=
# Same switch for the NVD feed, which covers the components OSV cannot see (Kong, Pulsar —
# they have no bitnami purl, only a CPE).
VECTASEC_NVD_DISABLED=
# By default NVD is asked only about components OSV could not see. Set to 1 to ask about every
# CPE-bearing component — belt and braces, at the cost of many more (rate-limited) requests.
VECTASEC_NVD_ALL=
# Optional NVD API key (https://nvd.nist.gov/developers/request-an-api-key). Without one the
# anonymous limit is ~5 requests / 30s, so large estates will hit the per-run query budget and
# say so in a coverage-gap finding rather than silently checking fewer components.
NVD_API_KEY=

# ── Email delivery (only needed if a tenant adds an "email" integration) ──
# SMTP is OPERATOR-level, not per-tenant: an email integration stores only its recipients, so
# without these the engine has nowhere to send and every email delivery fails with
# "SMTP_HOST is not set" (visible in Settings → Integrations → Recent deliveries).
# SMTP_HOST is the only required one; the rest have the defaults shown.
SMTP_HOST=
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_FROM=vectasec@localhost
# Optional — omit both for an unauthenticated relay. SMTP_PASSWORD stays in this file only;
# it is never stored in the database and never travels through the console.
SMTP_USERNAME=
SMTP_PASSWORD=

# ── AI (optional — rule-based fallback runs if ALL are unset) ──
# Any key enables grounded AI triage. Providers are tried in this order:
# Anthropic, then OpenAI, then Gemini — a failure on one hands off to the next.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# A Google AI Studio key (https://aistudio.google.com/apikey), e.g. AIza… — NOT a
# GCP service-account-bound key, which dies with its service account.
GEMINI_API_KEY=

# ── Local Kafka to scan in Phase 0 (Docker) ──
KAFKA_BOOTSTRAP=localhost:9092
