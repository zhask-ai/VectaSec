# ─────────────────────────────────────────────────────────────
# VectaSec — environment. Copy to `.env` and fill in.
# `.env` is gitignored. NEVER commit real values.
# ─────────────────────────────────────────────────────────────

# ── Supabase: NON-SECRET (safe in the browser / fine to share) ──
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_PUBLISHABLE_KEY
# same two, exposed to the Next.js console:
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_PUBLISHABLE_KEY

# ── Supabase: SECRET (server-side only — do NOT paste in chat) ──
# From Settings → API (service_role / secret key):
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
# From Settings → Database (connection string; includes your DB password):
DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# ── Engine ──
ENGINE_PORT=8000

# ── AI (optional — rule-based fallback runs if ALL are unset) ──
# Any key enables grounded AI triage. Providers are tried in this order:
# Anthropic, then OpenAI, then Gemini — a failure on one hands off to the next.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# A Google AI Studio key (https://aistudio.google.com/apikey), e.g. AIza… — NOT a
# GCP service-account-bound key, which dies with its service account.
GEMINI_API_KEY=

# ── Local Kafka to scan in Phase 0 (Docker) ──
KAFKA_BOOTSTRAP=localhost:9092
