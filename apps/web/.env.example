# Console env — copy to .env.local (gitignored).
#
# Next.js reads .env files from the APP directory (apps/web), not the repo root, so the root
# .env is not picked up here. That separation is deliberate rather than an inconvenience:
# the console gets ONLY the variables listed in this file.
#
# The console is READ-ONLY over the data plane. It talks to Postgres as `authenticated`,
# which has SELECT-only RLS policies scoped to the user's tenant. It must NEVER receive
# SUPABASE_SERVICE_ROLE_KEY or DATABASE_URL — those bypass RLS, and the whole
# tenant-isolation guarantee with them. Mutations go through the engine API.
#
# The two NEXT_PUBLIC_* values are public by design: they are inlined into the browser
# bundle. RLS is what protects the data, not the secrecy of the anon key.

NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# Email (Resend) — SERVER-ONLY secrets, never NEXT_PUBLIC_*. Used by the mail-sending server
# code (sign-in notifications etc.); Supabase's own auth emails are configured separately as
# custom SMTP in the Supabase dashboard.
# RESEND_API_KEY: create at https://resend.com/api-keys (starts "re_").
# EMAIL_FROM: "VectaSec <onboarding@resend.dev>" for testing (delivers only to your own
# inbox), or an address on a domain verified in Resend for real recipients.
RESEND_API_KEY=<resend-api-key>
EMAIL_FROM=VectaSec <onboarding@resend.dev>
