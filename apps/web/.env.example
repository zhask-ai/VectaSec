# Console env — copy to .env.local (gitignored).
#
# Next.js reads .env files from the APP directory (apps/web), not the repo root, so the root
# .env is not picked up here. That separation is deliberate rather than an inconvenience:
# these are the only two variables the console may have.
#
# The console is READ-ONLY. It talks to Postgres as `authenticated`, which has SELECT-only
# RLS policies scoped to the user's tenant. It must NEVER receive SUPABASE_SERVICE_ROLE_KEY
# or DATABASE_URL — those bypass RLS, and the whole tenant-isolation guarantee with them.
# Mutations go through the engine API.
#
# Both values below are public by design: NEXT_PUBLIC_* is inlined into the browser bundle.
# RLS is what protects the data, not the secrecy of the anon key.

NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
